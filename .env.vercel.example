# Copy these into Vercel → Project → Settings → Environment Variables
# Production URL: https://repo-mind-blue.vercel.app
# These four must be the origin only — never an email, never /api/auth/callback/github
APP_URL=https://repo-mind-blue.vercel.app
AUTH_URL=https://repo-mind-blue.vercel.app
NEXTAUTH_URL=https://repo-mind-blue.vercel.app
NEXT_PUBLIC_APP_URL=https://repo-mind-blue.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=ajyenduc@gmail.com
NEXT_PUBLIC_GITHUB_REPO_OWNER=Ajyendu
NEXT_PUBLIC_GITHUB_REPO_NAME=RepoMind

# GitHub OAuth App → Authorization callback URL (exact):
#   https://repo-mind-blue.vercel.app/api/auth/callback/github
# Also keep localhost if you sign in locally:
#   http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# --- Database (REQUIRED for sign-in — Neon / Vercel Postgres / Supabase) ---
# Without these, GitHub login fails with error=Configuration after callback.
# DATABASE_URL = Neon POOLED URL (host contains "-pooler")
# DIRECT_URL   = Neon DIRECT URL (no "-pooler" in host)
# IMPORTANT: Remove "&channel_binding=require" from both URLs if Prisma fails on Vercel.
DATABASE_URL=
DIRECT_URL=

# --- Redis (Upstash recommended on Vercel) ---
REDIS_URL=

# --- App secrets ---
GITHUB_TOKEN=
GEMINI_API_KEY=
ADMIN_GITHUB_USERNAME=Ajyendu

# Optional
BLOB_READ_WRITE_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_URL=
KV_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_RETRY_JOB_SECRET=
CRON_SECRET=
